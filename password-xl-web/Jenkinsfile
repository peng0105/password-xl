def BRANCH = 'master'
def PROJECT = 'password-xl'
def MODULE = 'password-xl-web'

pipeline {
    agent {
        label 'nodejs-24'
    }

    triggers {
        GenericTrigger(
            genericVariables: [
                [key: 'ref', value: '$.ref'],
                [key: 'files', value: '$.commits[*].modified[*]'],
                [key: 'files_added', value: '$.commits[*].added[*]'],
                [key: 'files_removed', value: '$.commits[*].removed[*]']
            ],
            causeString: 'Gitea 推送触发构建: $ref',
            token: "${PROJECT}",
            regexpFilterText: '$ref $files $files_added $files_removed',
            regexpFilterExpression: "(?s)^refs/heads/${BRANCH}.*(${MODULE}/|k8s/web/).*"
        )
    }

    environment {
        IMAGE_NAME = "repo.huangyp.cn/${PROJECT}/${MODULE}"
        DOCKER_HUB_IMAGE = "docker.io/huangypeng/password-xl-web"
        TENCENT_IMAGE = "ccr.ccs.tencentyun.com/password-xl/password-xl-service-web"
        REGISTRY_PROXY = "http://192.168.31.3:7890"
        YARN_REGISTRY = "https://nexus.huangyp.cn/repository/npm-group/"
        MODULE_NAME = "${MODULE}"
        PROJECT_NAME = "${PROJECT}"
    }

    options {
        buildDiscarder(logRotator(numToKeepStr: '10'))
        timeout(time: 10, unit: 'MINUTES')
    }

    stages {
        stage('Install & Build') {
            steps {
                container('node') {
                    sh '''#!/bin/bash

set -euo pipefail

cd ${MODULE_NAME}

echo "🏗️ 设置 npm 仓库..."
export COREPACK_HOME="${WORKSPACE}/.corepack"
export COREPACK_NPM_REGISTRY="${YARN_REGISTRY%/}"
export YARN_NPM_REGISTRY_SERVER="${YARN_REGISTRY}"

echo "🧶 启用项目声明的 Yarn 版本..."
corepack prepare yarn@4.18.0 --activate
corepack yarn --version
corepack yarn config get npmRegistryServer

echo "📦 安装依赖..."
corepack yarn install --immutable

echo "🛠️ 构建前端静态资源..."
corepack yarn build

                    '''
                }
            }
        }

        stage('Build & Push Image') {
          steps {
            container('buildkit') {
              sh '''

set -euo pipefail

echo "🛠️ 使用 BuildKit 构建并推送镜像..."
buildctl-daemonless.sh build \
--frontend dockerfile.v0 \
--local context="${WORKSPACE}/${MODULE_NAME}" \
--local dockerfile="${WORKSPACE}/${MODULE_NAME}" \
--opt filename=Dockerfile \
--output type=image,\\"name=${IMAGE_NAME}:${BUILD_NUMBER},${IMAGE_NAME}:latest\\",push=true

              '''
            }
          }
        }

        stage('Mirror Image') {
            steps {
                container('buildkit') {
                    withCredentials([
                        usernamePassword(
                            credentialsId: 'dockerhub-password-xl',
                            usernameVariable: 'DOCKERHUB_USERNAME',
                            passwordVariable: 'DOCKERHUB_PASSWORD'
                        ),
                        usernamePassword(
                            credentialsId: 'tencent-ccr-password-xl',
                            usernameVariable: 'TENCENT_USERNAME',
                            passwordVariable: 'TENCENT_PASSWORD'
                        )
                    ]) {
                        sh '''#!/bin/sh

set -euo pipefail
umask 077

export DOCKER_CONFIG="${WORKSPACE}/.docker-${BUILD_TAG}"
export HTTP_PROXY="${REGISTRY_PROXY}"
export HTTPS_PROXY="${REGISTRY_PROXY}"
export NO_PROXY="repo.huangyp.cn,ccr.ccs.tencentyun.com,localhost,127.0.0.1"
MIRROR_CONTEXT="${WORKSPACE}/.image-mirror-${BUILD_TAG}"
trap 'rm -rf "${DOCKER_CONFIG}" "${MIRROR_CONTEXT}"' EXIT

mkdir -p "${DOCKER_CONFIG}" "${MIRROR_CONTEXT}"

dockerhub_auth="$(printf '%s:%s' "${DOCKERHUB_USERNAME}" "${DOCKERHUB_PASSWORD}" | base64 | tr -d '\n')"
tencent_auth="$(printf '%s:%s' "${TENCENT_USERNAME}" "${TENCENT_PASSWORD}" | base64 | tr -d '\n')"

printf '{"auths":{"https://index.docker.io/v1/":{"auth":"%s"},"ccr.ccs.tencentyun.com":{"auth":"%s"}}}\n' \
  "${dockerhub_auth}" "${tencent_auth}" > "${DOCKER_CONFIG}/config.json"

printf '%s\n' 'ARG SOURCE_IMAGE' 'FROM ${SOURCE_IMAGE}' > "${MIRROR_CONTEXT}/Dockerfile"

echo "🚚 同步镜像到 Docker Hub 和腾讯云 CCR..."
buildctl-daemonless.sh build \
  --frontend dockerfile.v0 \
  --local context="${MIRROR_CONTEXT}" \
  --local dockerfile="${MIRROR_CONTEXT}" \
  --opt filename=Dockerfile \
  --opt build-arg:SOURCE_IMAGE="${IMAGE_NAME}:${BUILD_NUMBER}" \
  --output type=image,\\"name=${DOCKER_HUB_IMAGE}:${BUILD_NUMBER},${DOCKER_HUB_IMAGE}:latest,${TENCENT_IMAGE}:${BUILD_NUMBER},${TENCENT_IMAGE}:latest\\",push=true

                        '''
                    }
                }
            }
        }

        stage('Deploy to Kubernetes') {
            steps {
                container('kubectl') {
                    withCredentials([file(
                        credentialsId: 'k8s-password-xl-deployer',
                        variable: 'KUBECONFIG'
                    )]) {
                        sh '''#!/bin/bash

set -euo pipefail

echo "🚀 部署 Web 相关 K8s 配置..."
kubectl apply -f k8s/web/service.yaml
kubectl apply -f k8s/web/deployment.yaml
kubectl apply -f k8s/web/ingress.yaml

echo "🔄 更新 Deployment 镜像..."
kubectl set image deployment/${MODULE_NAME} \
${MODULE_NAME}=${IMAGE_NAME}:${BUILD_NUMBER} \
-n ${PROJECT_NAME}

echo "⏳ 等待滚动更新完成..."
kubectl rollout status deployment/${MODULE_NAME} -n ${PROJECT_NAME} --timeout=60s

echo "✅ 部署完成"

                        '''
                    }
                }
            }
        }
    }
}
