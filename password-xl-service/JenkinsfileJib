pipeline {
    agent { label 'graalvm-jdk-25' }

     environment {
        IMAGE_NAME = "repo.huangyp.cn/password-xl/password-xl-service-jvm"
        DOCKER_HUB_IMAGE = "docker.io/huangypeng/password-xl-service-jvm"
        TENCENT_IMAGE = "ccr.ccs.tencentyun.com/password-xl/password-xl-service-jvm"
        REGISTRY_PROXY = "http://192.168.31.3:7890"
        GRADLE_USER_HOME = '/home/jenkins/.gradle'
        LANG = 'C.UTF-8'
        LC_ALL = 'C.UTF-8'
    }

    options {
        buildDiscarder(logRotator(numToKeepStr: '10'))
        timeout(time: 30, unit: 'MINUTES')
    }

    stages {
        stage('Build & Push Image with Jib') {
            steps {
              container('graalvm') {
                    writeFile file: 'password-xl-service/nexus.init.gradle', text: '''
allprojects {
  buildscript {
    repositories {
      maven { url = uri("https://nexus.huangyp.cn/repository/maven-public/") }
    }
  }
  repositories {
    maven { url = uri("https://nexus.huangyp.cn/repository/maven-public/") }
  }
}
'''.stripIndent()
                echo "=== 构建并推送镜像 ==="
                sh '''#!/bin/bash
                    set -e
                    cd password-xl-service
                    chmod +x ./gradlew

                    export HOME="${WORKSPACE}"
                    export XDG_CONFIG_HOME="${WORKSPACE}/.config"
                    export XDG_CACHE_HOME="${WORKSPACE}/.cache"
                    mkdir -p \
                      "${XDG_CONFIG_HOME}/google-cloud-tools-java/jib" \
                      "${XDG_CACHE_HOME}/google-cloud-tools-java/jib"

                    java -version
                    ./gradlew clean jib --init-script nexus.init.gradle --info --stacktrace \
                      -Djib.to.image="${IMAGE_NAME}" \
                      -Djib.to.tags="${BUILD_NUMBER},latest" \
                      -Djib.baseImageCache="${XDG_CACHE_HOME}/google-cloud-tools-java/jib/base" \
                      -Djib.applicationCache="${XDG_CACHE_HOME}/google-cloud-tools-java/jib/application" \
                      --console=plain \
                      --build-cache \
                      -x test
                '''
              }
            }
        }

        stage('Mirror Image') {
            steps {
                container('buildkit') {
                    withCredentials([
                        usernamePassword(
                            credentialsId: 'dockerhub-password-xl',
                            usernameVariable: 'DOCKERHUB_USERNAME',
                            passwordVariable: 'DOCKERHUB_PASSWORD'
                        ),
                        usernamePassword(
                            credentialsId: 'tencent-ccr-password-xl',
                            usernameVariable: 'TENCENT_USERNAME',
                            passwordVariable: 'TENCENT_PASSWORD'
                        )
                    ]) {
                        sh '''#!/bin/sh

set -euo pipefail
umask 077

export DOCKER_CONFIG="${WORKSPACE}/.docker-${BUILD_TAG}"
export HTTP_PROXY="${REGISTRY_PROXY}"
export HTTPS_PROXY="${REGISTRY_PROXY}"
export NO_PROXY="repo.huangyp.cn,ccr.ccs.tencentyun.com,localhost,127.0.0.1"
MIRROR_CONTEXT="${WORKSPACE}/.image-mirror-${BUILD_TAG}"
trap 'rm -rf "${DOCKER_CONFIG}" "${MIRROR_CONTEXT}"' EXIT

mkdir -p "${DOCKER_CONFIG}" "${MIRROR_CONTEXT}"

dockerhub_auth="$(printf '%s:%s' "${DOCKERHUB_USERNAME}" "${DOCKERHUB_PASSWORD}" | base64 | tr -d '\n')"
tencent_auth="$(printf '%s:%s' "${TENCENT_USERNAME}" "${TENCENT_PASSWORD}" | base64 | tr -d '\n')"

printf '{"auths":{"https://index.docker.io/v1/":{"auth":"%s"},"ccr.ccs.tencentyun.com":{"auth":"%s"}}}\n' \
  "${dockerhub_auth}" "${tencent_auth}" > "${DOCKER_CONFIG}/config.json"

printf '%s\n' 'ARG SOURCE_IMAGE' 'FROM ${SOURCE_IMAGE}' > "${MIRROR_CONTEXT}/Dockerfile"

echo "🚚 同步镜像到 Docker Hub 和腾讯云 CCR..."
buildctl-daemonless.sh build \
  --frontend dockerfile.v0 \
  --local context="${MIRROR_CONTEXT}" \
  --local dockerfile="${MIRROR_CONTEXT}" \
  --opt filename=Dockerfile \
  --opt build-arg:SOURCE_IMAGE="${IMAGE_NAME}:${BUILD_NUMBER}" \
  --output type=image,\\"name=${DOCKER_HUB_IMAGE}:${BUILD_NUMBER},${DOCKER_HUB_IMAGE}:latest,${TENCENT_IMAGE}:${BUILD_NUMBER},${TENCENT_IMAGE}:latest\\",push=true

                        '''
                    }
                }
            }
        }
    }
}
